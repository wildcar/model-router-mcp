# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_FILE=logs/router.log
LOG_LEVEL=INFO
DB_PATH=data/router.db
BLOB_DIR=data/blobs

# --- HTTP defaults ---
HTTP_TIMEOUT_SECONDS=60
HTTP_RETRIES=2

# --- OpenRouter (chat + image catalog) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_CACHE_TTL_SECONDS=1800

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_API_MODEL=claude-sonnet-4-6

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-2

# --- ElevenLabs (text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_TTS_VOICE_NAME=Nadia
ELEVENLABS_TTS_VOICE_ID=

# --- Codex (OAuth image generation) ---
# Point this at a DEDICATED auth.json copy to avoid clobbering ort_bot/hermes
# refresh tokens (single-use rotation hazard — see openai-auth-sync).
CODEX_AUTH_PATH=
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_IMAGE_MAIN_MODEL=gpt-5.4
CODEX_IMAGE_TOOL_MODEL=gpt-image-2
CODEX_IMAGE_SIZE=1024x1536
CODEX_IMAGE_QUALITY=medium

# --- CLI engines ---
CODEX_COMMAND=codex exec --model gpt-5.5
CLAUDE_COMMAND=claude
CLI_RUN_TIMEOUT_SEC=1800
CLI_ALLOWED_CWD_ROOTS=

# --- Routing defaults (per modality) ---
DEFAULT_CHAT_MODEL=
DEFAULT_IMAGE_MODEL=
DEFAULT_STT_MODEL=
DEFAULT_TTS_MODEL=
