# --- Server ---
HOST=127.0.0.1
PORT=8000
LOG_FILE=logs/router.log
LOG_LEVEL=INFO
DB_PATH=data/router.db
BLOB_DIR=data/blobs
# When set, /mcp requires `Authorization: Bearer <AUTH_TOKEN>`. Generate with:
#   openssl rand -hex 32
# Leave empty for local dev. The web console/API is guarded separately (nginx).
AUTH_TOKEN=

# --- HTTP defaults ---
HTTP_TIMEOUT_SECONDS=60
HTTP_RETRIES=2

# --- Self identity ---
# Who the router says it is to providers with an app-identity parameter
# (OpenRouter's HTTP-Referer / X-Title) when the caller sent no app_url/app_name.
SELF_APP_URL=https://mr.wildcar.org
SELF_APP_NAME=model-router-mcp

# --- OpenRouter (chat + image catalog) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_CACHE_TTL_SECONDS=1800

# --- Catalog sync ---
# How often (seconds) every provider's model list is re-read in the background,
# so retired model ids are noticed before a request fails. 0 turns the timer off
# (the TTL-guarded sync on reads still runs). Manual trigger: POST /api/registry/refresh.
CATALOG_SYNC_INTERVAL_SECONDS=21600

# --- DeepSeek (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Anthropic / Claude API ---
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_API_MODEL=claude-sonnet-4-6

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-2

# --- ElevenLabs (text-to-speech) ---
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_NAME=Nadia
ELEVENLABS_TTS_VOICE_ID=

# --- Replicate (predictions; most models bill per second of compute) ---
# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=https://api.replicate.com/v1
# Which models the registry carries. Replicate publishes thousands; a registry is
# a curated list, not a mirror. `owner/name` or `owner/name:task`, comma
# separated. Empty means this provider reports no catalog at all — which is not
# the same as an empty one, and deliberately so: an empty catalog would tell the
# sync to retire every Replicate row, including hand-added ones.
REPLICATE_MODELS=black-forest-labs/flux-schnell:text-to-image,black-forest-labs/flux-kontext-pro:image-to-image,meta/musicgen:text-to-audio
# Hold the create call open this long for a synchronous answer (API ceiling 60).
# A fast image then never enters the poll loop.
REPLICATE_WAIT_SECONDS=60
# Give up after this and cancel. Also sent as Cancel-After, so a prediction this
# process abandons stops billing instead of running to completion.
REPLICATE_POLL_DEADLINE_SECONDS=900
REPLICATE_POLL_MIN_INTERVAL_SECONDS=1.0
REPLICATE_POLL_MAX_INTERVAL_SECONDS=10.0
# How long a model's version hash and input schema are cached in process.
REPLICATE_MODEL_TTL_SECONDS=3600
# Results are fetched into the blob store because Replicate's own links expire in
# about an hour. Anything bigger stays a link, and the run still succeeds.
REPLICATE_MAX_OUTPUT_MB=32
REPLICATE_MAX_OUTPUT_FILES=8
# Put the model's own progress output on the run timeline.
REPLICATE_STREAM_LOGS=true

# --- Handing our own files to a provider ---
# REQUIRED whenever Replicate is enabled. Not "nice to have": Replicate takes
# file inputs as a URL, or inline up to 256 KB, and a photo taken on a phone is
# 2-5 MB. With these two empty, EVERY image request from a mobile client fails
# at the adapter — the console says «настроен наполовину» and /plan flags it, but
# the first sign otherwise is a failed run after the key and the model are in.
# Set this to a host that resolves to this service, e.g. https://blob.example.org
PUBLIC_BLOB_BASE_URL=
# Links are signed and expire. Without a key nothing is ever served on that
# path — a missing setting must fail closed, not open the blob store. So a base
# URL on its own delivers nothing; both are needed or neither does anything.
PUBLIC_BLOB_SIGNING_KEY=
PUBLIC_BLOB_URL_TTL_SECONDS=900

# --- Local models (computed in this process; provider `local`) ---
# Weights live here, one subdirectory per model: deploy/fetch-models.sh downloads
# them and checks their sha256 (UVDoc: uvdoc/UVDoc_grid.onnx + .data, ~32 MB).
# Without the files a run answers `model_not_loaded` — an installation error, do
# not retry it. Runtime libraries: pip install -e '.[local]' (CPU only, no CUDA).
LOCAL_MODELS_DIR=data/models
# How many local runs compute at once. They share the CPU with the router, so a
# third one waits for a slot rather than slowing every chat answer.
LOCAL_MAX_CONCURRENCY=2
# A run past this answers `timeout` (retriable); the thread finishes on its own.
LOCAL_RUN_TIMEOUT_SECONDS=60

# --- Codex (OAuth: text, vision, image generation) ---
# Point at the codex CLI's own auth.json of the SAME user. Never a copy:
# the refresh token is single-use, a reused copy gets the whole family revoked
# (see openai-auth-sync).
CODEX_AUTH_PATH=
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# Text model that calls the image tool (the picture is drawn by the tool model
# below). It leads only while its codex-oauth row in the registry is active;
# otherwise the router leads with a live text model of the provider and writes
# `fallback_reason` into the log. Two ways a slug dies, both seen in 2026-09:
#  - the catalog drops it and the backend answers HTTP 400 "model is not
#    supported when using Codex with a ChatGPT account" (gpt-5.4, 09-05);
#  - the catalog KEEPS listing it and the backend answers HTTP 404
#    model_not_found (gpt-5.5, 09-08). The first such answer retires the row
#    for a day regardless of the catalog, and the image request is repeated
#    once with the next live leader.
# Still set a live one: the fallback costs one refused call per retired slug.
CODEX_IMAGE_MAIN_MODEL=gpt-5.6-sol
# The slug in the image_generation tool, and the registry row images are logged
# under. The backend ignores it, and the tool's size/quality with it: any slug
# draws with its own gpt-image-2-codex at auto/auto (checked 2026-09-10), so
# gpt-image-2.5-* cannot be chosen here. The log's usage_raw carries what was
# actually applied (backend_image_model, actual_size, actual_quality). A new
# value only renames the row; callers pinned to the old id would hit a retired one.
CODEX_IMAGE_TOOL_MODEL=gpt-image-2
# Sent to the model-list endpoint, which filters models by client version.
CODEX_CLIENT_VERSION=0.146.0
# Defaults for the tool's size/quality (`params.size` / `params.quality` per
# request). The backend treats both as auto and the leading model picks; only
# the orientation can be steered, and only through the prompt text.
CODEX_IMAGE_SIZE=1024x1536
CODEX_IMAGE_QUALITY=medium

# --- CLI engines ---
# The same slug rule applies here; the CLI has no fallback of its own.
CODEX_COMMAND=codex exec --model gpt-5.6-sol
CLAUDE_COMMAND=claude
CLI_RUN_TIMEOUT_SEC=1800
# The claude CLI reports total_cost_usd under a subscription too, where nothing
# was charged. true -> that sum is logged as notional and kept out of totals.
CLAUDE_CLI_SUBSCRIPTION=true
CLI_ALLOWED_CWD_ROOTS=
# Default working dir for CLI runs (use a dedicated empty dir; empty = process cwd)
CLI_DEFAULT_CWD=

# --- Routing defaults (per billing group) ---
DEFAULT_CHAT_MODEL=
DEFAULT_IMAGE_MODEL=
DEFAULT_STT_MODEL=
DEFAULT_TTS_MODEL=speechkit-tts-v3

# --- Runs in flight ---
# How many runs the console may have going at once. Three because one SQLite
# connection behind one write lock serves the whole service.
MAX_CONCURRENT_RUNS=3
# How many finished runs stay in the in-process registry (the log is the
# durable record; this is a cache for the tab that was closed and reopened).
RUN_REGISTRY_SIZE=200

# --- Retention ---
# 0 means keep forever, which is how the service behaved before there was a
# policy. Rows are small and are the only record of what was spent; response
# files are almost all of the bytes on disk and can go earlier.
LOG_RETENTION_DAYS=0
BLOB_RETENTION_DAYS=0
# The nightly sweep. It does nothing while both lifetimes are 0.
RETENTION_SWEEP_INTERVAL_SECONDS=86400

# --- Yandex SpeechKit (TTS) ---
YANDEX_API_KEY=
YANDEX_TTS_BASE_URL=https://tts.api.cloud.yandex.net
YANDEX_TTS_VOICE=lera
YANDEX_FOLDER_ID=
