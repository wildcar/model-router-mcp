[Unit]
Description=Model Router MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SVC_USER__
Group=__SVC_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
# Single worker: in-memory AppCore, one aiosqlite connection, one FastMCP
# session-manager instance (see docs/adr/0003, 0004).
ExecStart=__APP_DIR__/.venv/bin/uvicorn router_mcp.main:app --host 127.0.0.1 --port __PORT__ --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=30

# Hardening (mirrors the movie-* MCP services on this host).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=__APP_DIR__/data __APP_DIR__/logs

[Install]
WantedBy=multi-user.target
