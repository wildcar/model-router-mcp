# Local agent / IDE state — do not commit (shared project skills stay tracked)
.claude/*
!.claude/skills/

# Environment / secrets (keep only .env.example tracked)
.env
.env.*
!.env.example

# OAuth / credential files (never commit)
auth.json
*.auth.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Add project-specific ignores below (build output, dependencies, caches, ...)

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Runtime data & logs
data/
logs/

# Playwright's browser cache and any stray node install from the e2e harness
node_modules/
